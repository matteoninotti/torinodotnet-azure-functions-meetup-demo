// Riepilogo di un run: percentili server-side, tempo di sola pipeline,
// overhead di piattaforma e contabilita' dei fallimenti.
//
// Identica per i tre linguaggi: raggruppa per `language`, che arriva dal
// payload di RESIZE_METRICS e non dal nome dell'app. Se un giorno si lanciasse
// un run contro due backend insieme, questa query li separerebbe da sola.
//
// Le due datetime vanno sostituite con la finestra del run: k6 stampa
// RUN_START e RUN_END in UTC proprio per questo. Il run non e' identificabile
// dai parametri della richiesta, perche' l'host REDIGE la query string nella
// telemetria (`?image=Redacted&width=Redacted`, D41) — la finestra temporale
// e' l'unico modo di isolarlo.
//
// Attenzione all'ingestion: tra la fine di un run e la sua comparsa qui
// passano 2-4 minuti. Una query lanciata subito restituisce meno righe di
// quante ne siano davvero state servite.
//
// ⚠️ IL RISULTATO HA DUE RIGHE PER LINGUAGGIO, e vanno lette separate.
// `phase` distingue la PRIMA richiesta servita da ciascuna istanza — a partire
// da `win_start - look_back`, non da `win_start` — da tutte le
// successive. La separazione non e' un raffinamento: D50 ha ritrattato un
// numero proprio perche' era stato calcolato senza di essa. L'overhead
// host<->worker vale ~180-200 ms sulla prima richiesta di un'istanza e ~7 ms
// sulle successive, quindi un valore aggregato dipende da quante istanze sono
// nate durante il run — cioe' dalla forma del carico, non dal linguaggio.
// Sommare le due righe e' lecito solo per i conteggi (requests, ok, failed),
// mai per i percentili.

let win_start = datetime(2026-09-10T16:03:50Z);
let win_end   = datetime(2026-09-10T16:04:20Z);
// Quanto si guarda INDIETRO rispetto a win_start per stabilire se un'istanza
// era gia' in servizio. Deve superare il tempo di scale-to-zero (~3-4 minuti,
// D56): sotto quella soglia un'istanza sopravvissuta al run precedente non
// verrebbe vista, e tornerebbe il difetto che questa riga esiste per chiudere.
// Non allarga la finestra di misura — serve solo a classificare le righe che
// stanno gia' dentro win_start..win_end.
let look_back = 30m;
// La prima richiesta servita da ciascuna istanza IN ASSOLUTO, non la prima che
// capita dentro la finestra. La differenza morde quando un run e' preceduto da
// poco da un altro sulla stessa app — che e' la regola, non l'eccezione: D90
// punto 1 IMPONE un run di riscaldamento identico subito prima della Metrica 1.
// Un'istanza gia' calda classificata come cold start gonfia la riga "1-prima" e
// toglie proprio le richieste a regime dalla riga da cui escono i numeri.
let first_seen = AppRequests
| where TimeGenerated between (win_start - look_back .. win_end) and Name == 'resize'
| summarize first_on_instance = min(TimeGenerated) by AppRoleInstance;
let metrics = AppTraces
| where TimeGenerated between (win_start .. win_end)
| where Message startswith 'RESIZE_METRICS'
// Il JSON si estrae con una regex e NON con substring(Message, 15), che pure
// funzionava su Python e .NET: il worker Go APPENDE gli attributi
// dell'invocazione in coda al messaggio (`... } trigger_type=httpTrigger`), e
// quella coda faceva fallire parse_json in silenzio — righe presenti, campi
// tutti null, percentili calcolati su zero valori (D87).
| extend m = parse_json(extract(@'^RESIZE_METRICS (\{.*\})', 1, Message))
| project OperationId,
          language = tostring(m.language),
          image    = tostring(m.image),
          n        = toint(m['count']),
          total_ms = todouble(m.total_ms);
AppRequests
| where TimeGenerated between (win_start .. win_end) and Name == 'resize'
// leftouter e NON inner: RESIZE_METRICS viene emesso solo dopo una pipeline
// riuscita, quindi un inner join scarterebbe in silenzio ogni 4xx/5xx — cioe'
// proprio le richieste che sotto burst interessano di piu' (D45).
| join kind=leftouter metrics on OperationId
| extend language = coalesce(language, 'n/d')
// L'overhead si calcola RIGA PER RIGA e poi se ne prendono i percentili. La
// differenza di due mediane, che questa query faceva prima, non e' la mediana
// delle differenze: e' un numero che non corrisponde a nessuna richiesta
// realmente servita, e su un run dove le istanze nascono di continuo restituiva
// il valore che D50 ha ritrattato (182,74 ms sulla finestra qui sopra).
| extend overhead_ms = DurationMs - total_ms
// Non serve partizionare anche per linguaggio: un AppRoleInstance appartiene a
// una sola function app, quindi a un solo linguaggio (verificato: su 747
// istanze in 30 giorni, nessuna ne tocca piu' di una).
//
// Questa join sostituisce un `sort by AppRoleInstance, TimeGenerated` seguito da
// `row_number(1, prev(AppRoleInstance) != AppRoleInstance)`, che partizionava
// correttamente ma solo DENTRO la finestra, e classificava quindi come cold
// start ogni istanza gia' calda all'inizio del run. Sul ladder Go del
// 2026-09-13 la differenza era di 4 istanze su 190. Toglie anche la
// serializzazione dell'intero flusso, che su un run da 1.500 righe e' la parte
// piu' cara della query.
| join kind=leftouter first_seen on AppRoleInstance
| extend phase = iff(TimeGenerated == first_on_instance, '1-prima sull istanza', '2-successive')
| summarize
    requests      = count(),
    ok            = countif(ResultCode == '200'),
    failed        = countif(ResultCode != '200'),
    with_metrics  = countif(isnotnull(total_ms)),
    // Quante istanze compaiono in questa fase: sulla riga "prima" e' il numero
    // di istanze nate o riusate durante la finestra, ed e' il contesto senza
    // il quale i percentili dell'altra riga non si interpretano.
    instances     = dcount(AppRoleInstance),
    p50_total_ms  = percentile(total_ms, 50),
    p95_total_ms  = percentile(total_ms, 95),
    p50_server_ms = percentile(DurationMs, 50),
    p95_server_ms = percentile(DurationMs, 95),
    p99_server_ms = percentile(DurationMs, 99),
    p50_overhead_ms = percentile(overhead_ms, 50),
    p95_overhead_ms = percentile(overhead_ms, 95),
    // Se il sampling fosse acceso questo sarebbe > 1 su almeno una riga: e' il
    // campo con cui Application Insights dichiara il fattore di sampling, piu'
    // diretto che contare le righe (D14, D41). Va guardato a ogni run, non una
    // volta sola: un p95 su un campione non uniforme non e' un p95.
    sampling_max  = max(ItemCount)
  by language, phase
| extend success_pct = round(100.0 * ok / requests, 2)
| project language, phase, requests, ok, failed, success_pct, with_metrics, instances,
          p50_total_ms, p50_server_ms, p50_overhead_ms, p95_overhead_ms,
          p95_total_ms, p95_server_ms, p99_server_ms, sampling_max
| order by language asc, phase asc
